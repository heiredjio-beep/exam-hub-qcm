# Serveur
PORT=4000
NODE_ENV=development

# Base de donnees PostgreSQL (conteneur Docker)
PGHOST=localhost
PGPORT=5433
PGUSER=examhub
PGPASSWORD=changeme
PGDATABASE=examhub

# Authentification
JWT_SECRET=remplacer-par-une-chaine-longue-et-aleatoire
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10

# Administrateur initial cree par le seed (RG-01)
SEED_ADMIN_EMAIL=admin@examhub.local
SEED_ADMIN_PASSWORD=Admin123!

# CORS
CORS_ORIGIN=http://localhost:5173
